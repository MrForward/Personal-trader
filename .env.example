# Optional model API credentials. Leave empty for the deterministic rules provider.
# Put real keys only in your local .env or host secret configuration, never in Git/chat.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Kite Connect app (paid Connect tier for live data). Secret stays in this file or host secrets only.
KITE_API_KEY=
KITE_API_SECRET=

# Enable only after choosing a paid-call budget. Rules/fixtures work without this.
TRADING_LAB_ALLOW_PAID_MODEL_CALLS=0

# The local dashboard has no public authentication. Keep it on loopback.
TRADING_LAB_HOST=127.0.0.1
TRADING_LAB_PORT=3000
TRADING_LAB_DB_PATH=./data/trading-lab.sqlite
